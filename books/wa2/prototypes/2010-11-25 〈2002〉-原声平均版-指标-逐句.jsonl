{"idx": 25, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我打开灯，那惧怕刺眼光线的双眼正逐渐适应着光明。", "start": 124.83, "dur": 4.67, "emotion": "中立", "emotion_score": 1.0, "hyp": "我打开灯,那惧怕刺眼光线的双眼正逐渐适应着光明。", "cer": 0.0, "sim_real": 0.579, "sim_anchor": 0.493, "near_anchor": "武也", "near_real": "春希", "f0": 139.1, "rate": 4.71, "jump": 1.1}
{"idx": 26, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我缓缓地晃着头，想要让大脑被现实所充斥，但那司空见惯的场景却毫不容情地冲入脑海。", "start": 130.57, "dur": 8.33, "emotion": "中立", "emotion_score": 1.0, "hyp": "我缓缓地晃着头,想要让大脑被现实所充斥,但那司空见惯的场景却毫不容情地冲入脑海。", "cer": 0.0, "sim_real": 0.365, "sim_anchor": 0.502, "near_anchor": "春希", "near_real": "春希", "f0": 142.9, "rate": 4.44, "jump": 1.17}
