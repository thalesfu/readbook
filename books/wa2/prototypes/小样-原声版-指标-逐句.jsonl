{"idx": 57, "speaker": "雪菜", "type": "台词", "mood": "轻声", "text": "“嗯…今年也多多关照”", "start": 60.53, "dur": 2.77, "emotion": "开心", "emotion_score": 1.0, "hyp": "今年暖く鑑賞。", "cer": 0.75, "sim_real": 0.491, "sim_anchor": 0.549, "near_anchor": "雪菜", "near_real": "雪菜", "f0": 296.3, "rate": 2.89, "jump": 1.04}
{"idx": 58, "speaker": "依绪", "type": "台词", "mood": "兴奋", "text": "“太，太好啦～肯接我电话！我可是心扑通直跳呢～”", "start": 63.86, "dur": 4.91, "emotion": "吃惊", "emotion_score": 1.0, "hyp": "太子ら、今節は電話、和子氏心普通直凋ね。", "cer": 0.778, "sim_real": 0.753, "sim_anchor": 0.616, "near_anchor": "依绪", "near_real": "依绪", "f0": 254.0, "rate": 3.67, "jump": 1.44}
