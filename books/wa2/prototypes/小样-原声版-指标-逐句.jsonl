{"idx": 61, "speaker": "雪菜", "type": "台词", "mood": "平常", "text": "“这样啊…现在在外面？”", "start": 80.8, "dur": 2.06, "emotion": "开心", "emotion_score": 0.971, "hyp": "是呀啊。现在在华民。", "cer": 0.5, "sim_real": 0.451, "sim_anchor": 0.5, "near_anchor": "雪菜", "near_real": "雪菜", "f0": 301.9, "rate": 3.89, "jump": 1.13}
