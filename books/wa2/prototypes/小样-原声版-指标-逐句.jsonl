{"idx": 10, "speaker": "春希", "type": "心理活动", "mood": "平常", "text": "………真是，两个本末倒置的家伙。", "start": 42.82, "dur": 2.4, "emotion": "中立", "emotion_score": 0.44, "hyp": "珍死、梁河本末統治的家父。", "cer": 0.636, "sim_real": 0.732, "sim_anchor": 0.403, "near_anchor": "武也", "near_real": "春希", "f0": 153.9, "rate": 4.59, "jump": 1.1}
