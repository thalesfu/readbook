{"idx": 70, "speaker": "依绪", "type": "台词", "mood": "平常", "text": "“抱歉，雪菜。就算被你恨我也认了…换人了哦”", "start": 114.85, "dur": 4.57, "emotion": "开心", "emotion_score": 0.682, "hyp": "周辺行きな。町村火にフラワーや人寮。官人寮を?", "cer": 1.118, "sim_real": 0.676, "sim_anchor": 0.603, "near_anchor": "依绪", "near_real": "依绪", "f0": 213.3, "rate": 3.72, "jump": 0.96}
