{"idx": 34, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "被牢牢地紧锁在，我记忆之匣中的三年前的回忆。", "start": 179.07, "dur": 4.17, "emotion": "生气", "emotion_score": 0.997, "hyp": "被牢牢地紧锁在我记忆这侠中的三年前的回忆", "cer": 0.1, "sim_real": 0.667, "sim_anchor": 0.832, "near_anchor": "春希", "near_real": "春希", "f0": 148.1, "rate": 4.8, "jump": 1.0}
{"idx": 35, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "与雪菜的相遇。与雪菜的歌声相遇。", "start": 183.95, "dur": 3.13, "emotion": "中立", "emotion_score": 1.0, "hyp": "与雪菜的相遇,与雪菜的歌声相遇,", "cer": 0.0, "sim_real": 0.657, "sim_anchor": 0.835, "near_anchor": "春希", "near_real": "春希", "f0": 129.0, "rate": 4.47, "jump": 1.16}
