{"idx": 22, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我并未，自梦中惊醒。而是很自然地醒了过来。", "start": 120.67, "dur": 4.38, "emotion": "生气", "emotion_score": 1.0, "hyp": "我并未自梦中惊醒,而是很自然地醒了过来。", "cer": 0.0, "sim_real": 0.68, "sim_anchor": 0.833, "near_anchor": "春希", "near_real": "春希", "f0": 144.1, "rate": 4.11, "jump": 1.23}
