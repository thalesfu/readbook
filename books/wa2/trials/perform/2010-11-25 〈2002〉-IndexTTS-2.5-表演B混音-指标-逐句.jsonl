{"idx": 39, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "然后…", "start": 221.16, "dur": 0.68, "emotion": "中立", "emotion_score": 0.948, "hyp": "然后,", "cer": 0.0, "sim_real": 0.497, "sim_anchor": 0.646, "near_anchor": "春希", "near_real": "春希", "f0": 136.8, "rate": null, "jump": 0.86}
