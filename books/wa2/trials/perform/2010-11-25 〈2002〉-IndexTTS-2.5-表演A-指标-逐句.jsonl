{"idx": 39, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "然后…", "start": 217.93, "dur": 0.67, "emotion": "中立", "emotion_score": 0.995, "hyp": "然后", "cer": 0.0, "sim_real": 0.514, "sim_anchor": 0.629, "near_anchor": "春希", "near_real": "春希", "f0": 132.2, "rate": null, "jump": 0.85}
