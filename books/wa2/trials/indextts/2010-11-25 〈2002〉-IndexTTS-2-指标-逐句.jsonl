{"idx": 26, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我缓缓地晃着头，想要让大脑被现实所充斥，但那司空见惯的场景却毫不容情地冲入脑海。", "start": 124.05, "dur": 7.67, "emotion": "生气", "emotion_score": 1.0, "hyp": "我缓缓地晃着头,想要让大脑被现实所充斥,但那司空见惯的场景却毫不容情地冲入脑海。", "cer": 0.0, "sim_real": 0.598, "sim_anchor": 0.851, "near_anchor": "春希", "near_real": "春希", "f0": 135.6, "rate": 4.83, "jump": 1.26}
