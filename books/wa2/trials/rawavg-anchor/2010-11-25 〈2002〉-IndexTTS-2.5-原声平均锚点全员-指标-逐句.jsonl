{"idx": 35, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "与雪菜的相遇。与雪菜的歌声相遇。", "start": 166.24, "dur": 3.15, "emotion": "中立", "emotion_score": 0.999, "hyp": "与雪菜的相遇,与雪菜的歌声相遇,", "cer": 0.0, "sim_real": 0.652, "sim_anchor": 0.841, "near_anchor": "春希", "near_real": "春希", "f0": 129.0, "rate": 4.45, "jump": 0.98}
