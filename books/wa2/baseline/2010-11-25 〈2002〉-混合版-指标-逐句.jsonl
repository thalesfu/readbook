{"idx": 42, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "尽管如此…", "start": 200.65, "dur": 0.75, "emotion": "中立", "emotion_score": 0.958, "hyp": "尽管如此,", "cer": 0.0, "sim_real": 0.482, "sim_anchor": 0.423, "near_anchor": "春希", "near_real": "春希", "f0": 156.9, "rate": 5.3, "jump": 0.67}
