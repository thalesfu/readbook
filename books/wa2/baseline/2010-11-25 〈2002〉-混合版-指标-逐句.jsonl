{"idx": 25, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我打开灯，那惧怕刺眼光线的双眼正逐渐适应着光明。", "start": 108.51, "dur": 4.89, "emotion": "开心", "emotion_score": 0.81, "hyp": "我打开灯,那惧怕刺眼光线的双眼正逐渐适应着光明。", "cer": 0.0, "sim_real": 0.407, "sim_anchor": 0.339, "near_anchor": "武也", "near_real": "武也", "f0": 129.0, "rate": 4.5, "jump": 1.04}
{"idx": 26, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我缓缓地晃着头，想要让大脑被现实所充斥，但那司空见惯的场景却毫不容情地冲入脑海。", "start": 114.65, "dur": 7.3, "emotion": "中立", "emotion_score": 1.0, "hyp": "我缓缓地晃着头,想要让大脑被现实所充斥,但那司空见惯的场景却毫不容情地冲入脑海。", "cer": 0.0, "sim_real": 0.181, "sim_anchor": 0.142, "near_anchor": "武也", "near_real": "武也", "f0": 168.4, "rate": 5.07, "jump": 1.33}
