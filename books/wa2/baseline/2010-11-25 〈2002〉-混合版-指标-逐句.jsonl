{"idx": 22, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我并未，自梦中惊醒。而是很自然地醒了过来。", "start": 95.58, "dur": 3.7, "emotion": "中立", "emotion_score": 0.791, "hyp": "我并未自梦中惊醒,而是很自然地醒了过来。", "cer": 0.0, "sim_real": 0.511, "sim_anchor": 0.624, "near_anchor": "春希", "near_real": "春希", "f0": 126.0, "rate": 4.87, "jump": 0.84}
