{"idx": 17, "speaker": "雪菜", "type": "台词", "mood": "轻声", "text": "“没事，吧？”", "start": 79.72, "dur": 0.71, "emotion": "开心", "emotion_score": 1.0, "hyp": "没事吧?", "cer": 0.0, "sim_real": 0.499, "sim_anchor": 0.65, "near_anchor": "雪菜", "near_real": "雪菜", "f0": 232.1, "rate": null, "jump": 0.78}
