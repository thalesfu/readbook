{"idx": 25, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我打开灯，那惧怕刺眼光线的双眼正逐渐适应着光明。", "start": 110.52, "dur": 4.74, "emotion": "中立", "emotion_score": 1.0, "hyp": "我打开灯,那惧怕刺眼光线的双眼正逐渐适应着光明。", "cer": 0.0, "sim_real": 0.512, "sim_anchor": 0.663, "near_anchor": "春希", "near_real": "春希", "f0": 132.2, "rate": 4.64, "jump": 1.07}
{"idx": 26, "speaker": "春希", "type": "旁白", "mood": "平常", "text": "我缓缓地晃着头，想要让大脑被现实所充斥，但那司空见惯的场景却毫不容情地冲入脑海。", "start": 116.24, "dur": 7.56, "emotion": "中立", "emotion_score": 1.0, "hyp": "我缓缓地晃着头,想要让大脑被现实所充斥,但那司空见惯的场景却毫不容情地冲入脑海。", "cer": 0.0, "sim_real": 0.249, "sim_anchor": 0.301, "near_anchor": "春希", "near_real": "武也", "f0": 110.3, "rate": 4.89, "jump": 1.22}
